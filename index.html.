<div class="sale-card"><div><b>Segundo Tenente</b><span class="sale-price">R$ 27,90</span></div><button class="buy-btn" onclick="requestPurchase('Segundo Tenente','27,90')">Solicitar</button></div>
<div class="sale-card"><div><b>Aspirante a Oficial</b><span class="sale-price">R$ 25,30</span></div><button class="buy-btn" onclick="requestPurchase('Aspirante a Oficial','25,30')">Solicitar</button></div></div>
<div class="sale-category">A.M.A.N</div><div class="sale-list">
<div class="sale-card"><div><b>Cadete</b><span class="sale-price">R$ 24,00</span></div><button class="buy-btn" onclick="requestPurchase('Cadete','24,00')">Solicitar</button></div></div>
<div class="sale-category">GRADUADOS</div><div class="sale-list">
<div class="sale-card"><div><b>Subtenente</b><span class="sale-price">R$ 19,00</span></div><button class="buy-btn" onclick="requestPurchase('Subtenente','19,00')">Solicitar</button></div>
<div class="sale-card"><div><b>1° Sargento</b><span class="sale-price">R$ 15,90</span></div><button class="buy-btn" onclick="requestPurchase('1° Sargento','15,90')">Solicitar</button></div>
<div class="sale-card"><div><b>2° Sargento</b><span class="sale-price">R$ 13,80</span></div><button class="buy-btn" onclick="requestPurchase('2° Sargento','13,80')">Solicitar</button></div>
<div class="sale-card"><div><b>3° Sargento</b><span class="sale-price">R$ 12,00</span></div><button class="buy-btn" onclick="requestPurchase('3° Sargento','12,00')">Solicitar</button></div></div>
</div>
<div id="divisionalTabContent" style="display:none">
<div class="card"><div class="eyebrow">PATENTES DIVISIONAIS</div><h2>Escolha uma divisão</h2><p class="muted">Selecione uma das opções disponíveis abaixo.</p></div>
<div class="sale-list">
<div class="sale-card"><div><b>Brigada de Infantaria Paraquedista</b></div><button class="buy-btn" onclick='requestDivisional("Brigada de Infantaria Paraquedista")'>Selecionar</button></div>
<div class="sale-card"><div><b>Rec Mec Cavalaria Mecanizada</b></div><button class="buy-btn" onclick='requestDivisional("Rec Mec Cavalaria Mecanizada")'>Selecionar</button></div>
<div class="sale-card"><div><b>Centro de Instrução de Guerra na Selva</b></div><button class="buy-btn" onclick='requestDivisional("Centro de Instrução de Guerra na Selva")'>Selecionar</button></div>
<div class="sale-card"><div><b>Comando de Inteligência e Defesa Cibernética</b></div><button class="buy-btn" onclick='requestDivisional("Comando de Inteligência e Defesa Cibernética")'>Selecionar</button></div>
<div class="sale-card"><div><b>Batalhão de Ações de Comandos</b></div><button class="buy-btn" onclick='requestDivisional("Batalhão de Ações de Comandos")'>Selecionar</button></div>
