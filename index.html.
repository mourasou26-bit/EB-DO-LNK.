<style>
:root{--bg:#080d0b;--panel:#101916;--panel2:#141f1a;--green:#19e889;--green2:#087b4b;--muted:#9aaca3;--line:#176b48;--white:#edf7f1}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#14251c 0,#080d0b 55%);color:var(--white);font:14px Inter,system-ui,Arial,sans-serif;min-height:100vh}
