<nav class="bottom"><button class="active" data-page="inicio" onclick="showPage('inicio')"><strong>⌂</strong>Início</button><button data-page="perfil" onclick="showPage('perfil')"><strong>♙</strong>Perfil</button><button data-page="loja" onclick="showPage('loja')"><strong>✧</strong>Código</button><button data-page="vendas" onclick="showPage('vendas')"><strong>🛒</strong>Vendas</button><button onclick="drawer(true)"><strong>☰</strong>Menu</button></nav>
<div class="drawer" id="drawer" onclick="if(event.target===this)drawer(false)"><aside class="side"><div class="sidehead"><div class="brand"><div class="logo">LNK</div>EB DO LNK</div><button style="width:auto;margin:0" onclick="drawer(false)">✕</button></div><p class="eyebrow">NAVEGAÇÃO</p><button onclick="go('inicio')">⌂　Início</button><button onclick="go('perfil')">♙　Meu Perfil</button><button onclick="go('loja')">✧　Código</button><button onclick="go('vendas')">🛒　Venda de Cargos</button><button onclick="go('registros')">▤　Registro de Ações</button><button onclick="go('divisoes')">⬡　Divisões</button><button onclick="go('ajuda')">?　Ajuda e Suporte</button><div class="notice" style="margin-top:16px">EB DO LNK<br>Organização • Disciplina • Respeito</div></aside></div>
<script>
async function connectDiscord(){
  document.getElementById('discordAuthMessage').textContent='Abrindo a autorização segura do Discord...';
  window.location.href='/auth/discord';
}
async function loadDiscordProfile(){
  const name=document.getElementById('discordProfileName');
  const status=document.getElementById('discordProfileStatus');
  const button=document.getElementById('discordVerifyBtn');
  const message=document.getElementById('discordAuthMessage');
  try{
    const response=await fetch('/api/me',{credentials:'same-origin'});
    if(!response.ok) throw new Error('Não foi possível consultar a sessão.');
    const data=await response.json();
    if(data.user){
      name.textContent=data.user.global_name || data.user.username;
      status.textContent='Perfil verificado • Discord conectado';
      message.textContent='Sua conta Discord foi conectada com sucesso.';
      button.textContent='✓ Discord conectado';
      button.disabled=true;
      button.style.opacity='.7';
      const avatar=document.querySelector('.avatar');
      if(data.user.avatar){
        avatar.innerHTML='<img alt="Avatar do Discord" style="width:100%;height:100%;border-radius:50%;object-fit:cover" src="https://cdn.discordapp.com/avatars/'+encodeURIComponent(data.user.id)+'/'+encodeURIComponent(data.user.avatar)+'.png?size=128">';
      } else { avatar.textContent=(data.user.username||'D').charAt(0).toUpperCase(); }
    } else {
      name.textContent='Perfil não verificado';
      status.textContent='Conecte sua conta Discord para verificar seu perfil';
      button.disabled=false;
    }
  }catch(error){
    message.textContent='Não foi possível consultar o servidor de login. Verifique se o backend está publicado.';
  }
}
async function logoutDiscord(){
  await fetch('/auth/logout',{method:'POST',credentials:'same-origin'});
  location.reload();
}
(function(){
  const params=new URLSearchParams(location.search);
  const result=params.get('login');
  if(result==='success') history.replaceState({},document.title,location.pathname+location.hash);
  if(result==='error'){
    document.getElementById('discordAuthMessage').textContent='Não foi possível concluir o login. Tente novamente.';
    history.replaceState({},document.title,location.pathname+location.hash);
  }
  loadDiscordProfile();
})();
function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.bottom button').forEach(b=>b.classList.toggle('active',b.dataset.page===id));window.scrollTo(0,0)}
function drawer(open){document.getElementById('drawer').classList.toggle('open',open)}
function go(id){showPage(id);drawer(false)}
function redeem(){let v=document.getElementById('code').value.trim();document.getElementById('codeMsg').textContent=v?'Este modelo ainda não está conectado a um sistema de validação de códigos.':'Digite um código antes de continuar.'}
function requestPurchase(cargo,preco){alert('Solicitação de compra: '+cargo+' — R$ '+preco+'. Entre em contato com a administração do EB DO LNK para confirmar a compra e a liberação do cargo.');}
function switchSalesTab(tab){
 const cargos=tab==='cargos';
 document.getElementById('cargosTabContent').style.display=cargos?'block':'none';
 document.getElementById('divisionalTabContent').style.display=cargos?'none':'block';
 document.getElementById('tabCargos').classList.toggle('active',cargos);
 document.getElementById('tabDivisional').classList.toggle('active',!cargos);
}
function requestDivisional(nome){alert('Divisão selecionada: '+nome+'. Entre em contato com a administração do EB DO LNK para confirmar sua solicitação.');}
</script>
</body></html>
