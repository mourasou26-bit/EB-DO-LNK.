<body>
<header><button class="menu-btn" onclick="drawer(true)" aria-label="Abrir menu">☰</button><div class="brand"><div class="logo">LNK</div><span>EB DO LNK</span></div><div class="spacer"></div><span class="online">● PAINEL ONLINE</span></header>
<main>
