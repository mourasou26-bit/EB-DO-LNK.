input{width:100%;padding:13px;border-radius:10px;background:#080e0b;border:1px solid #286044;color:white;outline:none;margin:8px 0}input:focus{border-color:var(--green)}
.bottom{position:fixed;bottom:0;left:0;right:0;background:#0b120f;border-top:1px solid #1c5037;display:flex;justify-content:space-around;padding:8px 4px calc(8px + env(safe-area-inset-bottom));z-index:6}.bottom button{background:none;border:0;color:#a9b8af;font-size:10px;display:grid;gap:4px;justify-items:center;cursor:pointer}.bottom button strong{font-size:19px}.bottom button.active{color:var(--green)}
.drawer{position:fixed;inset:0;z-index:10;background:#0009;display:none}.drawer.open{display:block}.side{width:min(310px,84vw);height:100%;overflow:auto;background:#0c1510;border-right:1px solid #216341;padding:17px}.sidehead{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.side button{width:100%;text-align:left;background:#142019;border:1px solid #1d4932;color:white;padding:12px;border-radius:10px;margin:4px 0;cursor:pointer}.side button:hover,.tile:hover{border-color:var(--green)}
.page{display:none}.page.active{display:block}.notice{border:1px dashed #26774c;background:#102219;border-radius:12px;padding:14px;color:#b8d9c6;font-size:12px;line-height:1.6}
.sale-category{margin:18px 0 9px;color:var(--green);font-size:13px;letter-spacing:1px;font-weight:900}.sale-card{background:#111b16;border:1px solid #254936;border-radius:13px;padding:14px;display:flex;align-items:center;justify-content:space-between;gap:10px}.sale-card b{display:block}.sale-price{color:var(--green);font-weight:900;font-size:15px;white-space:nowrap}.buy-btn{border:1px solid #218653;background:#123523;color:#dfffee;border-radius:9px;padding:9px 11px;font-weight:800;cursor:pointer;margin-top:8px}.sale-list{display:grid;gap:9px}.sales-tabs{display:flex;gap:9px;margin:14px 0}.sales-tab{flex:1;border:1px solid #276244;background:#142019;color:#edf7f1;border-radius:10px;padding:12px 8px;font-weight:900;cursor:pointer}.sales-tab.active{background:linear-gradient(90deg,#0cc878,#27f39a);color:#04150d;border-color:#19e889}
footer{text-align:center;color:#60746a;font-size:11px;padding:15px}
@media(min-width:700px){main{padding-top:28px}.hero{padding:26px}.hero h1{font-size:34px}.grid{grid-template-columns:repeat(3,minmax(0,1fr))}.bottom{max-width:700px;left:50%;transform:translateX(-50%);border:1px solid #1c5037;border-radius:16px 16px 0 0}}
</style>
